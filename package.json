{
  "name": "fridge-to-meal",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter \"./packages/*\" build && pnpm --filter \"./apps/*\" build",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:up": "docker compose up -d --wait",
    "db:up:native": "bash tools/start-local-postgres.sh",
    "db:down": "docker compose down -v",
    "test:hooks": "node --test .claude/hooks/*.test.mjs .githooks/*.test.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --build --force",
    "lint": "pnpm lint:code && pnpm lint:deps",
    "lint:code": "eslint .",
    "lint:deps": "depcruise apps packages",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:hooks && pnpm build"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "@eslint/js": "^10.0.1",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
